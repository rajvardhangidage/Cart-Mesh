server:
  port: 8087
spring:
  application:
    name: notification-service
  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:5432/${DB_NAME:notificationdb}
    username: ${DB_USER:your_db_username}
    password: ${DB_PASSWORD:your_db_password}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: true
    locations: classpath:db/migration
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
app:
  jwt:
    secret: ${JWT_SECRET:your_example_jwt_secret_key_change_me_in_production_environment_32chars}
springdoc:
  api-docs:
    path: /api/notifications/v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
